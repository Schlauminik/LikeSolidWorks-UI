<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<package format="1" xmlns="https://wiki.freecad.org/Package_Metadata">
  <!-- Anzeigename im Addon-Manager (Dominik, 17.10.): "LikeSolid".
       Die Werkbank selbst heisst weiter "LikeSolidWorks UI" (unten bei
       <content>). Die Suche des Addon-Managers prueft Name, Beschreibung
       und <tag> - deshalb steht "LikeSolidWorks UI" in beiden, damit die
       Suche nach dem Werkbank-Namen das Paket findet. -->
  <name>LikeSolid</name>
  <description>
    LikeSolidWorks UI: a SOLIDWORKS-like user interface for FreeCAD -
    CommandManager-style ribbon, SOLIDWORKS names and terms for parts,
    assemblies and drawings. Interface in English and German.
    SOLIDWORKS-aehnliche Benutzeroberflaeche und
    Werkzeuge fuer FreeCAD.
    Modernes Ribbon-Layout, Feature-Manager und ein Skizzier-Workflow,
    der sich an SOLIDWORKS orientiert. Entwickelt und getestet unter
    Linux Mint mit FreeCAD 1.1. SOLIDWORKS ist eine Marke von Dassault
    Systemes; dieses Projekt ist nicht mit Dassault Systemes verbunden.
    Not affiliated with Dassault Systemes.
  </description>
  <version>0.10.0</version>
  <date>2026-10-18</date>

  <maintainer email="ladewig_dominik@web.de">Dominik Ladewig</maintainer>

  <!-- Zwei Lizenzen: Quelltext LGPL (wie FreeCAD selbst), Grafiken und
       Vorlagen CC-BY-SA (die LGPL passt schlecht auf Nicht-Quelltext).
       Die Bezeichner sind offizielle SPDX-Kuerzel - nicht abkuerzen,
       sonst stuft der Addon-Manager sie strenger ein. -->
  <license file="LICENSE-Code">LGPL-2.1-or-later</license>
  <license file="LICENSE-Assets">CC-BY-SA-4.0</license>

  <!-- Pflicht fuer den Addon-Index. Nutzer bekommen den Zweig "release"
       (nur gepruefte Freigaben, tools/freigabe.sh); entwickelt wird auf
       "master". Diese Datei steht in beiden Zweigen gleich. -->
  <url type="repository" branch="release">https://github.com/Schlauminik/LikeSolidWorks-UI</url>
  <url type="readme">https://github.com/Schlauminik/LikeSolidWorks-UI/blob/release/README.md</url>

  <freecadmin>1.0</freecadmin>

  <tag>LikeSolidWorks UI</tag>
  <tag>LikeSolidWorks</tag>
  <tag>Ribbon</tag>
  <tag>TechDraw</tag>
  <tag>Deutsch</tag>
  <tag>English</tag>

  <content>
    <workbench>
      <classname>LikeSolidWorksUIWorkbench</classname>
      <subdirectory>./</subdirectory>
      <icon>resources/icons/swui_workbench.svg</icon>
      <name>LikeSolidWorks UI</name>
      <description>SOLIDWORKS-aehnliche Oberflaeche und Werkzeuge</description>
    </workbench>
  </content>
</package>
