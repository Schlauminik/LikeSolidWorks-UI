<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<package format="1" xmlns="https://wiki.freecad.org/Package_Metadata">
  <name>LikeSolidWorks UI</name>
  <description>
    SOLIDWORKS-aehnliche Benutzeroberflaeche und Werkzeuge fuer FreeCAD.
    Modernes Ribbon-Layout, Feature-Manager und ein Skizzier-Workflow,
    der sich an SOLIDWORKS orientiert. Entwickelt und getestet unter
    Linux Mint mit FreeCAD 1.1. SOLIDWORKS ist eine Marke von Dassault
    Systemes; dieses Projekt ist nicht mit Dassault Systemes verbunden.
  </description>
  <version>0.1.0</version>
  <date>2026-10-15</date>

  <maintainer email="ladewig_dominik@web.de">Dominik Ladewig</maintainer>

  <!-- Zwei Lizenzen: Quelltext LGPL (wie FreeCAD selbst), Grafiken und
       Vorlagen CC-BY-SA (die LGPL passt schlecht auf Nicht-Quelltext).
       Die Bezeichner sind offizielle SPDX-Kuerzel - nicht abkuerzen,
       sonst stuft der Addon-Manager sie strenger ein. -->
  <license file="LICENSE-Code">LGPL-2.1-or-later</license>
  <license file="LICENSE-Assets">CC-BY-SA-4.0</license>

  <!-- TODO vor der Veroeffentlichung: echte Adresse eintragen und die
       Zeile aktivieren. Pflicht fuer die Aufnahme in den Addon-Index;
       "branch" muss der Zweig sein, auf dem diese Datei liegt.
  <url type="repository" branch="main">https://github.com/BENUTZER/REPO</url>
  -->

  <freecadmin>1.0</freecadmin>

  <content>
    <workbench>
      <classname>LikeSolidWorksUIWorkbench</classname>
      <subdirectory>./</subdirectory>
      <icon>resources/icons/swui_workbench.svg</icon>
      <name>LikeSolidWorks UI</name>
      <description>SOLIDWORKS-aehnliche Oberflaeche und Werkzeuge</description>
    </workbench>
  </content>
</package>
